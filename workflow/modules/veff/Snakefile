import os

from snakemake.utils import min_version, validate

min_version("9.0")

# Variant effect annotation: prepared VCFs in, per-variant features out. Combines the modules
# in the subfolders; each of them can also be imported alone. The inputs come from the modules
# vcf_prep and gtf_transcripts. See config.schema.yaml.
validate(config, "config.schema.yaml")

# the annotation modules write to <output_dir>/<module output>
VEFF_DIR = os.path.abspath(config["output_dir"])
RESOURCES_DIR = os.path.abspath(config.get("resources_dir", f"{VEFF_DIR}/resources"))

STRIPPED_VCF = config["vcf"]
VALID_VCF = config["valid_vcf"]
VCF_PQ = config["vcf_parquet"]
GTF_TRANSCRIPTS = config["gtf_transcripts"]
CHROM_ALIAS_TSV = config["chrom_alias_tsv"]
GENOME = {
    "human_genome_version": config["human_genome_version"],
    "fasta_file": config["fasta_file"],
}
ANNOTATOR = config["annotator"]

if "use_gpu" in config["enformer"]:
    raise ValueError(
        "enformer.use_gpu is no longer supported: set the top-level config key use_gpu instead. "
        "In the AbExp config, replace system.enformer.use_gpu with use_gpu."
    )


def optional(cfg, *keys):
    return {k: cfg[k] for k in keys if k in cfg}


VEP_CONFIG = {
    **config["vep"],
    "vcf": STRIPPED_VCF,
    "output_dir": VEFF_DIR,
    "resources_dir": RESOURCES_DIR,
    **GENOME,
    "chrom_alias_tsv": CHROM_ALIAS_TSV,
}

module vep:
    snakefile: "vep/Snakefile"
    config: VEP_CONFIG

use rule * from vep

CONSEQUENCES = str(rules.veff__vep_parse.output.veff_pq)


# builds its transcript database from gff3_file and the GENCODE transcript FASTA; the config
# schema requires the FASTA for `annotator: "mehari"`
if ANNOTATOR == "mehari" or "gencode_transcripts_fasta" in config["mehari"]:
    MEHARI_CONFIG = {
        "gencode_gff3": config["gff3_file"],
        **config["mehari"],
        "vcf": STRIPPED_VCF,
        "output_dir": VEFF_DIR,
        "resources_dir": RESOURCES_DIR,
        **GENOME,
        **optional(config, "fasta_file_idx"),
        "chrom_alias_tsv": CHROM_ALIAS_TSV,
    }

    module mehari:
        snakefile: "mehari/Snakefile"
        config: MEHARI_CONFIG

    use rule * from mehari

    if ANNOTATOR == "mehari":
        CONSEQUENCES = str(rules.veff__mehari_annotation.output.veff_pq)


# off by default: needs a conda environment with reloftee (see loftee/config.schema.yaml).
# reloftee calls its own consequences from the VCF and its genome_annotation (default
# gff3_file), independently of the annotator above.
if config["loftee"].get("enabled"):
    # The vep module downloads the same LOFTEE data for its LOFTEE plugin, and keeps these
    # download rules with `loftee_plugin: false`. The loftee module reads these files, and its
    # own download rules are not imported, so that each file has one rule and one location.
    # Paths set in the section loftee must exist.
    LOFTEE_DATA = {"human_ancestor_fa": str(rules.veff__vep_download_loftee_human_ancestor.output.fasta)}
    if config["human_genome_version"] == "hg38":
        LOFTEE_DATA["gerp_bigwig"] = str(rules.veff__vep_download_loftee_gerp_bigwig.output.bigwig)
        LOFTEE_DATA["phylocsf_sqlite"] = str(rules.veff__vep_download_loftee_conservation_file.output.sql)

    LOFTEE_CONFIG = {
        "genome_annotation": config["gff3_file"],
        **LOFTEE_DATA,
        **config["loftee"],
        "vcf": STRIPPED_VCF,
        "output_dir": VEFF_DIR,
        "resources_dir": RESOURCES_DIR,
        **GENOME,
        **optional(config, "fasta_file_idx"),
    }

    module loftee:
        snakefile: "loftee/Snakefile"
        config: LOFTEE_CONFIG

    use rule * from loftee exclude veff__loftee_download_human_ancestor, veff__loftee_download_gerp_bigwig, veff__loftee_download_phylocsf_sqlite


# VEP writes the column LoF only with LOFTEE and CADD_RAW only with CADD. If a plugin fails to
# load, VEP only warns, so tissue_specific_vep checks the columns of the plugins that are on.
# mehari writes neither column. true is the default in vep/config.schema.yaml.
REQUIRED_CONSEQUENCE_COLUMNS = []
if ANNOTATOR == "vep":
    if config["vep"].get("loftee_plugin", True):
        REQUIRED_CONSEQUENCE_COLUMNS.append("LoF")
    if config["vep"].get("cadd_plugin", True):
        REQUIRED_CONSEQUENCE_COLUMNS.append("CADD_RAW")

TISSUE_SPECIFIC_VEP_CONFIG = {
    **config["tissue_specific_vep"],
    "consequences": CONSEQUENCES,
    "required_columns": REQUIRED_CONSEQUENCE_COLUMNS,
    "gtf_transcripts": GTF_TRANSCRIPTS,
    "output_dir": VEFF_DIR,
    "resources_dir": RESOURCES_DIR,
    "chrom_alias_tsv": CHROM_ALIAS_TSV,
}

module tissue_specific_vep:
    snakefile: "tissue_specific_vep/Snakefile"
    config: TISSUE_SPECIFIC_VEP_CONFIG

use rule * from tissue_specific_vep


ABSPLICE_CONFIG = {
    **config["absplice"],
    "use_gpu": config["use_gpu"],
    "valid_vcf": VALID_VCF,
    "vcf_parquet": VCF_PQ,
    "output_dir": VEFF_DIR,
    "resources_dir": RESOURCES_DIR,
    **GENOME,
    "chrom_alias_tsv": CHROM_ALIAS_TSV,
}

module absplice:
    snakefile: "absplice/Snakefile"
    config: ABSPLICE_CONFIG

use rule * from absplice


# off by default: Pangolin is slow without a GPU, and the output is not read by
# tissue_specific_vep, fset or predict. AbSplice2 reads the MMSplice table, the SpliceMaps and the
# tissue mapping of the absplice module.
if config["absplice2"].get("enabled"):
    ABSPLICE2_CONFIG = {
        "gff3_file": config["gff3_file"],
        **config["absplice2"],
        "use_gpu": config["use_gpu"],
        "valid_vcf": VALID_VCF,
        "mmsplice_splicemap": str(rules.veff__mmsplice_splicemap.output.result),
        "splicemap_5": [str(f) for f in rules.veff__mmsplice_splicemap.input.splicemap_5],
        "splicemap_3": [str(f) for f in rules.veff__mmsplice_splicemap.input.splicemap_3],
        "output_dir": VEFF_DIR,
        "resources_dir": RESOURCES_DIR,
        **GENOME,
        **optional(config, "fasta_file_idx"),
    }
    # Snakemake pickles the module config for the scripts, so the config holds plain strings only.
    # By default, the absplice2 module gets the tissue mapping of the absplice module from
    # workflow.source_path itself.
    if config["absplice"].get("tissue_mapping_csv"):
        ABSPLICE2_CONFIG["tissue_mapping_csv"] = config["absplice"]["tissue_mapping_csv"]

    module absplice2:
        snakefile: "absplice2/Snakefile"
        config: ABSPLICE2_CONFIG

    use rule * from absplice2


ENFORMER_CONFIG = {
    **config["enformer"],
    "use_gpu": config["use_gpu"],
    "vcf": STRIPPED_VCF,
    "gtf_transcripts": GTF_TRANSCRIPTS,
    "output_dir": VEFF_DIR,
    "resources_dir": RESOURCES_DIR,
    **GENOME,
}

module enformer:
    snakefile: "enformer/Snakefile"
    config: ENFORMER_CONFIG

use rule * from enformer


# off by default: needs its own conda environment, and its output is not read by
# tissue_specific_vep, fset or predict. The NMD features use the isoform proportions of the
# tissue_specific_vep module.
if config["nmd_scanner"].get("enabled"):
    NMD_SCANNER_CONFIG = {
        "isoform_proportions_pq": str(rules.isoform_proportions_tsv_to_parquet.output.file),
        **config["nmd_scanner"],
        "vcf": STRIPPED_VCF,
        "output_dir": VEFF_DIR,
        "resources_dir": RESOURCES_DIR,
        **GENOME,
        **optional(config, "fasta_file_idx"),
        "gff3_file": config["gff3_file"],
    }

    module nmd_scanner:
        snakefile: "nmd_scanner/Snakefile"
        config: NMD_SCANNER_CONFIG

    use rule * from nmd_scanner


include: "setup.smk"
