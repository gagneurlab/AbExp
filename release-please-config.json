{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "include-component-in-tag": true,
  "bump-minor-pre-major": true,
  "separate-pull-requests": true,
  "group-pull-request-title-pattern": "chore${scope}: release abexp-tensorflow libraries",
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "abexp-tensorflow",
      "components": ["kipoi-enformer", "abexp-splicing"]
    }
  ],
  "bootstrap-sha": "e7cfe6b1f5d93698b52d316a1fd6558facabda48",
  "packages": {
    ".": {
      "release-type": "simple",
      "include-component-in-tag": false,
      "exclude-paths": ["packages"],
      "extra-files": [
        { "type": "generic", "path": "README.md" }
      ]
    },
    "packages/abexp_utils": {
      "package-name": "abexp-utils",
      "component": "abexp-utils",
      "extra-files": [
        { "type": "generic", "path": "README.md" },
        { "type": "generic", "path": "/workflow/envs/abexp-veff-py.yaml" }
      ]
    },
    "packages/kipoi_enformer": {
      "package-name": "kipoi-enformer",
      "component": "kipoi-enformer",
      "extra-files": [
        { "type": "generic", "path": "README.md" },
        { "type": "generic", "path": "/workflow/modules/veff/envs/abexp-tensorflow-cpu.yaml" },
        { "type": "generic", "path": "/workflow/modules/veff/envs/abexp-tensorflow-cuda.yaml" }
      ]
    },
    "packages/abexp_splicing": {
      "package-name": "abexp-splicing",
      "component": "abexp-splicing",
      "extra-files": [
        { "type": "generic", "path": "README.md" },
        { "type": "generic", "path": "/workflow/modules/veff/envs/abexp-tensorflow-cpu.yaml" },
        { "type": "generic", "path": "/workflow/modules/veff/envs/abexp-tensorflow-cuda.yaml" }
      ]
    }
  }
}
