import os

from snakemake.utils import min_version, validate

min_version("9.0")

# AbSplice2-DNA (https://github.com/gagneurlab/absplice2): aberrant splicing per GTEx tissue from
# MMSplice with SpliceMaps and from Pangolin. The module runs Pangolin; the MMSplice table and the
# SpliceMaps come from the absplice module. See config.schema.yaml.
validate(config, "config.schema.yaml")

# Rules use `conda: CONDA_ENV_YAML_DIR.join("<env>.yaml")`, which does not depend on the folder
# of the rule file. `workflow.current_basedir` is also correct if this is a module.
CONDA_ENV_YAML_DIR = workflow.current_basedir.join("envs")
# CPU or CUDA variant of the PyTorch environment of Pangolin
PANGOLIN_CONDA_ENV_YAML = CONDA_ENV_YAML_DIR.join(
    "absplice2-pangolin-cuda.yaml" if config["use_gpu"] else "absplice2-pangolin-cpu.yaml"
)

# One version per step. Bump the key of the earliest step whose outputs change, see
# "When jobs rerun" in README.md.
OUTPUT_VERSION = {
    "pangolin": 2,
    "absplice2": 1,
}

OUTPUT_DIR = os.path.abspath(config["output_dir"])
RESOURCES_DIR = os.path.abspath(config.get("resources_dir", f"{OUTPUT_DIR}/resources"))

HUMAN_GENOME_VERSION = config["human_genome_version"]

FASTA_FILE = os.path.abspath(config["fasta_file"])
FASTA_INDEX_FILE = os.path.abspath(config.get("fasta_file_idx", config["fasta_file"] + ".fai"))
GFF3_FILE = os.path.abspath(config["gff3_file"])
VALID_VCF_FILE_PATTERN = config["valid_vcf"]
MMSPLICE_SPLICEMAP_CSV_PATTERN = config["mmsplice_splicemap"]
SPLICEMAP5 = config["splicemap_5"]
SPLICEMAP3 = config["splicemap_3"]
TISSUE_MAPPING_CSV = config.get("tissue_mapping_csv") or workflow.source_path(
    "../absplice/resources/AbSplice_tissue_mapping.csv"
)

MODEL_PKL = os.path.abspath(config.get("model_pkl", f"{RESOURCES_DIR}/absplice2/AbSplice_2_DNA.pkl"))

# The published weights of Pangolin: 12 models, 3 replicates for each of its 4 heads. The file
# names are those of abexp.pangolin.MODEL_FILES; the Snakemake process does not import the package.
PANGOLIN_MODELS_DIR = f"{RESOURCES_DIR}/absplice2/pangolin_models"
PANGOLIN_MODEL_FILES = [f"final.{replicate}.{head}.3.v2" for head in (0, 2, 4, 6) for replicate in (1, 2, 3)]
# Pangolin takes the annotated splice sites from the exons of the transcripts with one of these
# tags in gff3_file. The default tags are those of the databases that Pangolin publishes for
# GENCODE v38. The lift37 files lack Ensembl_canonical for some genes (v40: 287 of 20,118 protein-coding
# genes). The three appris tags mark a transcript for these genes. Do not replace them by the
# appris_principal_1 to _5 of GENCODE: these tag many transcripts of genes that have a canonical one.
PANGOLIN_TRANSCRIPT_TAGS = config.get(
    "pangolin_transcript_tags",
    {
        "hg19": ["Ensembl_canonical", "appris_principal", "appris_candidate", "appris_candidate_longest"],
        "hg38": ["Ensembl_canonical"],
    }[HUMAN_GENOME_VERSION],
)


include: "download.smk"
include: "absplice2.smk"
